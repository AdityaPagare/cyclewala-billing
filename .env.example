# Copy to .env.local (development) or set these in the host's environment (production).
# .env* files are gitignored - never commit real values.

# --- Owner sign-in -------------------------------------------------------------------
# REQUIRED in production. Without them nobody can sign in. (In development, with these empty, you can sign in
# as owner@cyclewala.local / cyclewala-dev.)
ADMIN_EMAIL=
ADMIN_PASSWORD=          # 10+ characters
# A long random string that signs the session cookie (openssl rand -hex 32). REQUIRED in production.
SESSION_SECRET=

# --- Database (MongoDB) ---------------------------------------------------------------
# A free MongoDB Atlas cluster works: Database Access -> add a user, Network Access -> allow your host,
# Connect -> Drivers -> copy the string and put the password in it.
# Leave empty to save everything as JSON files in ./data (or DATA_DIR) instead.
MONGODB_URI=
# MONGODB_DB=cyclewala_billing
# DATA_DIR=

# --- The shop website -----------------------------------------------------------------
# Where the Brand and model dropdowns on Items read the live catalogue from (the website's /api/products).
# SHOP_SITE_URL=https://cyclewala.shop

# --- Sending invoices -----------------------------------------------------------------
# Public address of this app, used in the invoice links sent to customers and for the logo in emails.
# NEXT_PUBLIC_SITE_URL=https://billing.example.com
# Email: a Gmail address with an App password (Google Account -> Security -> App passwords).
# SMTP_USER=cyclewalastore@gmail.com
# SMTP_PASS=
# MAIL_DRY_RUN=true   # print emails to the server log (and ./data/last-mail.html) instead of sending
# WhatsApp needs nothing here: it opens WhatsApp with the invoice link ready to send.
